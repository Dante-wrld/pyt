# PumpPortal currently documents this WebSocket endpoint.
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
PUMPPORTAL_API_KEY=

# Paper portfolio limits. These are examples, not recommendations.
PAPER_TRADE_SIZE_SOL=0.02
MAX_OPEN_POSITIONS=3
MAX_TOTAL_EXPOSURE_SOL=0.06

# Event-level launch gates.
MIN_VIRTUAL_SOL=5
MIN_MARKET_CAP_SOL=5
MAX_MARKET_CAP_SOL=500
MAX_CREATOR_BUY_SOL=5
REJECT_UNKNOWN_PRICE=true

# Simulated exits.
TAKE_PROFIT_PCT=30
STOP_LOSS_PCT=20

DATABASE_PATH=launch_guard.db
LOG_LEVEL=INFO

# Free Solana RPC wallet watcher. Replace these with a dedicated provider later
# if public-endpoint rate limits become a problem.
SOLANA_RPC_HTTP_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_WS_URL=wss://api.mainnet-beta.solana.com
# Your public wallet address only. Never put a seed phrase or private key here.
SOLANA_WALLET_ADDRESS=
WATCHED_WALLETS=
PRICE_POLL_SECONDS=5
COPY_MIN_LIQUIDITY_USD=10000

# Separate holdings/sell-guidance board (read-only unless live mode is enabled).
PORTFOLIO_POLL_SECONDS=15
PORTFOLIO_MIN_VALUE_USD=0.01
PORTFOLIO_SNAPSHOT_PATH=launch_guard_portfolio.json

# Opt-in Solana execution. The profit ladder uses known cost bases. Optional
# portfolio-signal execution can also act on wallet holdings; keep live false
# until both preflight modes and the signer have been verified.
# The private key is stored in the macOS Keychain, never in this file.
AUTO_TRADE_FLOOR_PERCENTAGES=false
AUTO_SELL_ENABLED=false
AUTO_SELL_LIVE=false
AUTO_SELL_PRINCIPAL_MULTIPLE=2.0
AUTO_SELL_HALF_PROFIT_MULTIPLE=3.0
AUTO_SELL_SECOND_STAGE_FRACTION=0.5
# Live-trial only (hunter_shadow_strategy.ShadowRecoveryPolicy): exit a
# Hunter-bought position if it hasn't gained STAGNATION_MIN_GAIN_PCT within
# STAGNATION_WINDOW_SECONDS of entry and momentum still isn't positive.
STAGNATION_WINDOW_SECONDS=300
STAGNATION_MIN_GAIN_PCT=3.0
AUTO_SELL_MAX_PRICE_IMPACT_PCT=8.0
AUTO_SELL_MAX_SLIPPAGE_BPS=1500
# Live-trial exits are sized from the signal itself (full sell on EXIT /
# EXIT WARNING, the configured stage fraction on TAKE PARTIAL / PROTECT
# PROFIT) with no model round trip. false restores model-sized exits.
LIVE_EXIT_DETERMINISTIC=true
AUTO_SELL_ADAPTIVE_CHUNKS=false
AUTO_SELL_MIN_CHUNK_FRACTION=0.01
AUTO_SELL_MAX_CHUNK_ATTEMPTS=8
AUTO_SELL_PORTFOLIO_SIGNALS=false
AUTO_SELL_TAKE_PARTIAL_FRACTION=0.5
AUTO_SELL_PROTECT_PROFIT_FRACTION=1.0
AUTO_SELL_EXIT_WARNING_FRACTION=1.0
AUTO_SELL_MIN_VALUE_USD=1.0
# Require the same wallet-wide sell decision on three fresh portfolio polls.
AUTO_SELL_SIGNAL_CONFIRMATION_POLLS=3
AUTO_SELL_SIGNAL_MAX_GAP_SECONDS=180
AUTO_SELL_EXCLUDED_MINTS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
JUPITER_API_KEY=

# Opt-in Solana USDC purchases. Automatic discovery can select confirmed,
# fresh BUY NOW/BUY ZONE candidates without manual mint entry. Keep live false
# until representative buy and sell preflights pass. Live buying also requires
# AUTO_SELL_ENABLED=true and AUTO_SELL_LIVE=true.
AUTO_BUY_ENABLED=false
AUTO_BUY_LIVE=false
AUTO_BUY_DISCOVERY=false
AUTO_BUY_DISCOVERY_MIN_SCORE=70
AUTO_BUY_DISCOVERY_MIN_LIQUIDITY_USD=50000
AUTO_BUY_SIGNAL_MAX_AGE_SECONDS=30
# Persist and recheck launch candidates so later BUY NOW/BUY ZONE transitions
# are not lost when the board rotates or Launch Guard restarts.
AUTO_BUY_WATCH_MAX_SECONDS=86400
AUTO_BUY_WATCH_MAX_CANDIDATES=250
AUTO_BUY_WATCH_BATCH_SIZE=10
AUTO_BUY_WATCH_RETRY_BASE_SECONDS=15
AUTO_BUY_WATCH_RETRY_MAX_SECONDS=300
AUTO_BUY_EXCLUDED_MINTS=
AUTO_BUY_SEED_SIZE_USDC=5.0
AUTO_BUY_MAX_SEED_BUYS=2
AUTO_BUY_MAX_OPEN_POSITIONS=2
AUTO_BUY_REINVEST_PROFIT_PCT=50.0
AUTO_BUY_MAX_PRICE_IMPACT_PCT=9.0
AUTO_BUY_MAX_SLIPPAGE_BPS=1700

# Optional post-sale recovery re-buy. This never predicts a bottom: it waits
# for a real drop, rebound, improving 5-minute flow, retained liquidity, and
# three consecutive qualifying polls. It uses AUTO_BUY_LIVE and the same two-
# seed-buy/profit-only budget above. Keep disabled until dry-run is reviewed.
AUTO_REBUY_ENABLED=false
AUTO_REBUY_COOLDOWN_SECONDS=600
AUTO_REBUY_MAX_WATCH_SECONDS=86400
AUTO_REBUY_MIN_DROP_PCT=10.0
AUTO_REBUY_MIN_REBOUND_PCT=5.0
AUTO_REBUY_MIN_ENTRY_DISCOUNT_PCT=5.0
AUTO_REBUY_MIN_MOMENTUM_PCT=3.0
AUTO_REBUY_MIN_BUY_SELL_RATIO=1.4
AUTO_REBUY_MIN_BUYS_M5=8
AUTO_REBUY_MIN_LIQUIDITY_USD=20000
AUTO_REBUY_MIN_LIQUIDITY_RETENTION_PCT=80.0
AUTO_REBUY_CONFIRMATION_POLLS=3
AUTO_REBUY_MAX_PER_TOKEN=1
AUTO_REBUY_MAX_SIZE_USDC=5.0

# Intelligent launch scoring and tiered USD paper sizes.
STANDARD_TRADE_SIZE_USD=10
MOONSHOT_TRADE_SIZE_USD=5
MAX_TOTAL_EXPOSURE_USD=30
INTELLIGENCE_WAIT_SECONDS=30
CORE_INTELLIGENCE_SCORE=75
MOONSHOT_INTELLIGENCE_SCORE=60
INTELLIGENCE_MIN_LIQUIDITY_USD=5000
CORE_MIN_LIQUIDITY_USD=20000
MAX_MARKET_CAP_LIQUIDITY_RATIO=30
MOONSHOT_MAX_MARKET_CAP_USD=500000
MOONSHOT_TAKE_PROFIT_PCT=5000
MOONSHOT_STOP_LOSS_PCT=40
MAX_PENDING_CANDIDATES=50

# Gold live watchlist. Only intelligence-qualified paper candidates appear.
RECOMMENDATION_LIMIT=10
RECOMMENDATION_POOL_SIZE=30
RECOMMENDATION_POLL_SECONDS=15
RECOMMENDATION_TTL_SECONDS=1800
PULLBACK_TRIGGER_PCT=8
PULLBACK_ZONE_MIN_PCT=4
PULLBACK_ZONE_MAX_PCT=6
PULLBACK_STARTED_PCT=2
PULLBACK_RECLAIM_PCT=2
ENTRY_CONFIRMATION_POLLS=3
ENTRY_MIN_SIGNAL_SCORE=65
ENTRY_MIN_LIQUIDITY_RETENTION_PCT=80
ENTRY_REQUIRE_NONFALLING_VOLUME=true
# Set to false to allow HIGH/MOONSHOT risk-labeled candidates through the
# shadow/live-trial entry check (all other checks - liquidity, momentum,
# volume, confirmations, and a hard AVOID-decision block - still apply).
ENTRY_REQUIRE_MEDIUM_RISK=true
MIN_ENTRY_REWARD_RISK_RATIO=2
BUY_NOW_MIN_RATIO=1.2
# Minimum buy/sell ratio for the MOMENTUM BUY path (an already-extended,
# still-rising candidate with rising volume - see recommendations.py's
# _momentum_buy_reason). Deliberately stricter than BUY_NOW_MIN_RATIO since
# there's no pullback-and-reclaim confirmation behind this decision.
MOMENTUM_BUY_MIN_RATIO=1.5
# Minimum five-minute trade count (buys_m5 + sells_m5) for the MOMENTUM BUY
# path. A ratio alone can't tell "1,700 real trades" from "13 trades" -
# this floor keeps thin, easily-skewed samples from counting as evidence.
MOMENTUM_BUY_MIN_TRADES=50
# Alternative confirmation path for MOMENTUM BUY: liquidity growth (percent,
# vs. the candidate's first-observed liquidity) that alone can satisfy the
# buy-pressure gate even if buy_sell_ratio falls short - real new capital is
# evidence a count-based ratio can miss during high-frequency two-sided
# trading.
MOMENTUM_BUY_MIN_LIQUIDITY_GROWTH_PCT=20
AVOID_ENTRY_MOMENTUM_PCT=-8
AVOID_ENTRY_SELL_PRESSURE_RATIO=2
COLOR_OUTPUT=true
RECOMMENDATION_SNAPSHOT_PATH=launch_guard_recommendations.json

# Optional phone notifications through Pushover. Register your own Pushover
# application and keep both 30-character keys only in your local .env.
PUSHOVER_ENABLED=false
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
PUSHOVER_DEVICE=
PUSHOVER_ALERT_DECISIONS=BUY NOW,BUY ZONE,MOMENTUM BUY,PULLBACK STARTED,WAIT FOR PULLBACK,AVOID
PUSHOVER_MIN_SCORE=60
PUSHOVER_COOLDOWN_SECONDS=300
PUSHOVER_PORTFOLIO_ALERT_DECISIONS=TAKE PARTIAL,PROTECT PROFIT,EXIT WARNING
PUSHOVER_HIGH_PRIORITY_DECISIONS=BUY NOW,BUY ZONE,MOMENTUM BUY,TAKE PARTIAL,PROTECT PROFIT,EXIT WARNING
PUSHOVER_PORTFOLIO_COOLDOWN_SECONDS=300

# Multichain recommendation discovery. Add comma-separated 0x token contracts
# to monitor exact tokens even when they are absent from the latest profile feed.
ETHEREUM_TOKEN_ADDRESSES=
BASE_TOKEN_ADDRESSES=
BNB_TOKEN_ADDRESSES=
BOB_TOKEN_ADDRESSES=
MONAD_TOKEN_ADDRESSES=
ROBINHOOD_TOKEN_ADDRESSES=
HYPEREVM_TOKEN_ADDRESSES=
MULTICHAIN_POLL_SECONDS=15

# Read-only wallet monitoring. This is a public address, never a private key.
# One shared 0x address is used on the configured EVM networks. HyperCore uses
# HYPERLIQUID_ADDRESS, which can be the same address.
EVM_WALLET_ADDRESS=
HYPERLIQUID_ADDRESS=
EVM_WALLET_POLL_SECONDS=10

# RPC endpoints used only for wallet transfer monitoring. Ethereum, Base, BNB,
# BOB, and Monad are intentionally blank: add a provider endpoint that supports
# eth_getLogs. The two defaults below are the networks' documented public
# endpoints.
ETHEREUM_RPC_URL=
BASE_RPC_URL=
BNB_RPC_URL=
BOB_RPC_URL=
MONAD_RPC_URL=
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm

# Adaptive paper exits and confirmed re-entry. STOP_LOSS_PCT (above) is also
# the live hunter's hard stop while principal is outstanding.
TRAILING_ACTIVATION_PCT=20
TRAILING_STOP_PCT=12
# Lock-in rule (live and `launch-guard-eval --exit-model ladder` read the same
# values): once a position's peak gain reaches LOCK_AFTER_GAIN_PCT, its stop
# rises to LOCK_STOP_PCT above entry until principal is recovered. 0 = off.
# Turn on only after `launch-guard-eval sweep --locks 0,8,10,15` holds up on
# the test split for more than one signal type (docs/evaluation.md).
LOCK_AFTER_GAIN_PCT=0
LOCK_STOP_PCT=8
MOMENTUM_EXIT_PCT=-8
SELL_PRESSURE_RATIO=1.5
LIQUIDITY_DROP_PCT=30
REENTRY_COOLDOWN_SECONDS=120
REENTRY_MOMENTUM_PCT=3
REENTRY_BUY_SELL_RATIO=1.4
MAX_REENTRIES=2

# OpenAI advisory agents. The real key belongs only in .env, never this file.
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5-mini

# Persistent agent shadow accounts and decisions. These stay local.
AGENT_CAPITAL_PATH=launch_guard_agent_capital.json
AGENT_DECISION_LOG_PATH=launch_guard_agent_decisions.jsonl
AGENT_COPY_SIGNAL_PATH=launch_guard_copy_signals.json

# One-time supervised mainnet canary. Defaults stay safe/off.
AGENT_LIVE_TEST_ENABLED=false
AGENT_LIVE_KILL_SWITCH=true
# The first canary is hard-coded to exactly $1; other values are rejected.
AGENT_LIVE_TEST_AMOUNT_USD=1
AGENT_LIVE_CANARY_PATH=launch_guard_live_canary.json

# --- Strategy profile ------------------------------------------------------
# Which feeds run, and which signals may place LIVE orders. Unset = previous
# behaviour (all feeds on, every buy decision allowed, any token age).
# Blocked signals are still scored, alerted, logged and outcome-tracked
# ("shadow only"); they just never reach an order. See docs/strategy-profile.md.
#
# Recommended starting profile: pullback entries on established tokens only.
FEED_PUMPPORTAL_LAUNCHES=false
FEED_SOLANA_MOMENTUM=true
# Optional paid CoinGecko key (any Pro tier - Analyst/Lite/etc; starts with
# "CG-"). The free, unauthenticated GeckoTerminal API stays the default for
# the solana-momentum feed and candle-pattern tagging; this key is only used
# as a fallback on that free API's rate limit (HTTP 429), retried once
# against pro-api.coingecko.com/onchain. Leave blank to only ever use the
# free API.
GECKOTERMINAL_API_KEY=
FEED_LAUNCHLAB=false
# Read-only CopyFomo monitor: records its own wallet's trades, never buys.
FEED_COPYFOMO_WALLETS=true
# CopyFomo's own trading wallet address.
COPYFOMO_SOLANA_WALLET=
# Wallets of the traders CopyFomo copies, as name:ADDRESS,name:ADDRESS.
# Watched read-only (recorded, never copied) so each CopyFomo buy can be
# attributed to a leader by mint and timing, and skipped trades measured.
COPYFOMO_LEADER_WALLETS=
# The same leaders' EVM wallets (name:0x...,...), recorded read-only on
# COPYFOMO_EVM_CHAIN. Needs that chain's RPC URL; each wallet adds one poll.
COPYFOMO_LEADER_EVM_WALLETS=
# Leader-held feed: put tokens the leaders above currently HOLD on the board,
# so your own entry rules decide (no waiting for their trades). Tokens only
# this feed found stay shadow-only via ENTRY_SHADOW_ONLY_SOURCES.
FEED_LEADER_HOLDINGS=true
ENTRY_SHADOW_ONLY_SOURCES=leader-held,leader-copy
LEADER_HOLDINGS_POLL_SECONDS=600
LEADER_HOLDINGS_MIN_USD=100
LEADER_HOLDINGS_MIN_LIQUIDITY_USD=50000
LEADER_HOLDINGS_MAX_CANDIDATES=10
# Copy-signal feed: turn a leader's own BUY (not just their resting
# holdings) into a copy-v1 signal, for direct attributed copies - the
# opposite tradeoff from leader-held (late but fresher). Also shadow-only
# via ENTRY_SHADOW_ONLY_SOURCES above by default.
FEED_LEADER_COPY_SIGNALS=true
COPY_SIGNAL_POLL_SECONDS=10
COPY_SIGNAL_TTL_SECONDS=1800
COPY_SIGNAL_MIN_USD=50
FEED_MULTICHAIN=false
ENTRY_ALLOWED_DECISIONS=BUY ZONE
ENTRY_MIN_TOKEN_AGE_DAYS=3

# Shadow-only research. Start launch-guard-trend-shadow to produce evidence.
# Swing reserves a $30 responsibility limit; no extra buys or wallet cash.
SWING_SHADOW_MANAGER_ENABLED=false
SHADOW_TREND_EVIDENCE_PATH=launch_guard_trend_evidence.json

# Paper-only: lets the hunter-v1 shadow loop (launch-guard-agents
# --shadow-core-loop) buy what the live freeze blocks (ENTRY_ALLOWED_DECISIONS,
# ENTRY_MIN_TOKEN_AGE_DAYS, ENTRY_SHADOW_ONLY_SOURCES, MOMENTUM_BUY_PAUSED),
# same intent as wide-v1 but using the model-approved hunter entries instead
# of taking every signal. live_trial.py and its entry decision
# (decide_hunter_entry) never read this flag and are never affected by it.
HUNTER_SHADOW_IGNORE_FREEZE=false

# Price-volume confirmation engine (price_volume.py). Always computed and
# shown on the board, logged on every buy signal, and recorded to
# board_samples for `launch-guard-eval pv-backtest`. Gates nothing until
# PV_ENABLED=true. See docs/evaluation.md before enabling.
PV_ENABLED=false
PV_MODE=veto
PV_SIGNALS=MOMENTUM BUY
PV_BLOCK_UNKNOWN=true
PV_EXIT_ENABLED=false
PV_TIMEFRAMES=60,300,900
PV_LOOKBACK=1800
PV_CONFIRMATIONS_REQUIRED=3
PV_CONFIRMATION_WINDOW=5
PV_RVOL_MIN=1.2
PV_EXHAUSTION_RVOL=3.0
PV_PULLBACK_MAX=25
PV_LIQUIDITY_DROP_PCT=15
PV_BUY_RATIO_MIN=0.55
PV_MIN_QUALITY=50
PV_MIN_SCORE=0
PV_HEALTH_WEIGHT=0.5
PV_SIGNAL_WEIGHT=0.5

# Early take-profit on the shared exit policy: sell everything once up this
# much while principal is at risk. 0 = off (live and existing books).
EARLY_TAKE_PCT=0
# momentum-take-v1 paper book (launch-guard-momentum-take): its own exits.
MOMENTUM_TAKE_PCT=2
MOMENTUM_TAKE_STAGNATION_SECONDS=1800
MOMENTUM_TAKE_DECISIONS=MOMENTUM BUY
MOMENTUM_TAKE_MAX_OPEN_POSITIONS=4
MOMENTUM_TAKE_BOOK_PATH=launch_guard_momentum_take_capital.json
# Wide-style paper books (wide-v1, wide-fresh-v1, momentum-take-v1).
PAPER_ORDER_USD=10
# PAPER_DAILY_LOSS_USD defaults to 60% of PAPER_ORDER_USD.

# Paper-only: hunter-v1 and the wide-v1 / wide-fresh-v1 / momentum-take-v1 books
# ignore tokens younger than this many minutes (minutes-old PumpPortal launches
# rugged paper positions -98% inside a minute; in recorded signals the 60-120 min
# window was the first with positive expectancy). 0 turns the guard off.
PAPER_MIN_TOKEN_AGE_MINUTES=60
# momentum-take-v1 can use its own value (unset = follow the shared one): it is the
# short-hold take-profit book, so it keeps testing very young tokens at 0.
MOMENTUM_TAKE_MIN_TOKEN_AGE_MINUTES=0

# Paper only: drop the daily loss cap so the paper books keep trading after a bad
# day (live is unaffected). HUNTER_SHADOW_IGNORE_DAILY_LOSS covers hunter-v1;
# PAPER_DAILY_LOSS_USD covers wide-v1 / wide-fresh-v1 / momentum-take-v1 (default is
# 60% of one position; a huge value turns it off).
HUNTER_SHADOW_IGNORE_DAILY_LOSS=true
PAPER_DAILY_LOSS_USD=1000000

# momentum-take-v1 quick exits: +MOMENTUM_TAKE_PCT clears the 1.2% round-trip cost,
# the stop is tighter than the shared one, and MOMENTUM_TAKE_MAX_HOLD_SECONDS sells
# whatever is left after that long regardless of momentum (0 = off). Poll cadence
# is MOMENTUM_TAKE_INTERVAL_SECONDS (default 30, the minimum).
MOMENTUM_TAKE_STOP_LOSS_PCT=10
MOMENTUM_TAKE_MAX_HOLD_SECONDS=300

# wide-fresh-v1 and momentum-take-v1: a token whose paper position closes down
# PAPER_RUG_LOSS_PCT or more is blocked for PAPER_RUG_BLOCK_HOURS on any signal
# (0 = off). A new-high rule alone re-bought a pump-and-dump token twice (-90% both).
PAPER_RUG_BLOCK_HOURS=24
PAPER_RUG_LOSS_PCT=30

# wide-fresh-v1 and momentum-take-v1: a token bought while under PAPER_YOUNG_BUY_MINUTES
# old is not bought again by that book until the token is at least
# PAPER_YOUNG_REBUY_AFTER_MINUTES old (PAPER_YOUNG_BUY_MINUTES=0 turns the rule off).
PAPER_YOUNG_BUY_MINUTES=60
PAPER_YOUNG_REBUY_AFTER_MINUTES=120

# wide-v1, wide-fresh-v1, momentum-take-v1: skip a token under PAPER_CHASE_YOUNG_MINUTES old that
# already rose PAPER_CHASE_MAX_M5_PCT in the last 5 minutes (0 = off). Young pump-chases were almost
# all of momentum-take-v1's paper losses.
PAPER_CHASE_MAX_M5_PCT=45
PAPER_CHASE_YOUNG_MINUTES=60

